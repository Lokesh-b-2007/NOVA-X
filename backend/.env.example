# Copy this file to `.env` in the backend/ directory and adjust as needed.
# Nothing here is a secret by default (no external API keys are required),
# but keep .env out of version control regardless.

# --- General ---
NOVA_ENV=development
NOVA_DEBUG=true
NOVA_CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite (default, zero setup):
NOVA_DATABASE_URL=sqlite:///./nova_x.db
# Postgres (uncomment and edit when ready to move off SQLite):
# NOVA_DATABASE_URL=postgresql+psycopg2://nova:nova@localhost:5432/nova_x

# --- Storage paths (defaults resolve relative to the NOVA-X/ repo root) ---
# NOVA_DATA_DIR=../data
# NOVA_MODELS_DIR=../models

# --- Known-class detector (YOLO) ---
NOVA_DETECTOR_WEIGHTS=yolov8n.pt
NOVA_DETECTOR_DEVICE=auto
NOVA_DETECTOR_CONF=0.35
NOVA_KNOWN_CLASSES=person,car,bicycle,dog

# --- OOD / novelty detection ---
NOVA_NOVELTY_UNKNOWN_THRESHOLD=0.70
NOVA_NOVELTY_SUSPICIOUS_THRESHOLD=0.40
NOVA_OOD_METHOD=hybrid

# --- Open-vocabulary detection (OWLv2) ---
NOVA_OVD_MODEL_ID=google/owlv2-base-patch16-ensemble
NOVA_OVD_VOCABULARY=chair,sofa,table,laptop,phone,bottle,cup,backpack,umbrella,book,keyboard,mouse,monitor,plant,lamp,bag,shoe,hat,clock,bench
NOVA_OVD_SCORE_THRESHOLD=0.1

# --- Clustering ---
NOVA_CLUSTERING_METHOD=dbscan
NOVA_DBSCAN_EPS=0.35
NOVA_DBSCAN_MIN_SAMPLES=3

# --- Continual learning ---
NOVA_MIN_DATASET_SIZE=30

# --- Webcam streaming ---
NOVA_MAX_FRAME_WIDTH=640
